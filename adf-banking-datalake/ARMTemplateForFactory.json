									},
									"type": "DateTime"
								},
								"source_schema": {
									"value": "banking",
									"type": "String"
								},
								"source_table": {
									"value": "customers",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_Banking",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Set_New_Watermark",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Lookup_New_Watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_new_watermark",
							"value": {
								"value": "@activity('Lookup_New_Watermark').output.firstRow.new_watermark",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Return_New_Watermark",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Set_New_Watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "pipelineReturnValue",
							"value": [
								{
									"key": "new_watermark",
									"value": {
										"type": "String"
									}
								}
							],
							"setSystemVariable": true
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"v_new_watermark": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-17T07:19:53Z"
			},
