		{
			"name": "[concat(parameters('factoryName'), '/PL_Banking_Customers_Incremental')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_Old_Watermark",
						"type": "Lookup",
						"dependsOn": [],
