{
	"name": "DS_ADLS_Dynamic_Parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_Banking",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_container": {
				"type": "String"
			},
			"p_folder": {
				"type": "String"
			},
			"p_file": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().p_folder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().p_container",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": [
			{
				"name": "customer_id",
				"type": "INT64"
			},
			{
				"name": "first_name",
				"type": "UTF8"
			},
			{
				"name": "last_name",
				"type": "UTF8"
			},
			{
				"name": "email",
				"type": "UTF8"
			},
			{
				"name": "phone",
				"type": "UTF8"
			},
			{
				"name": "date_of_birth",
				"type": "DATE"
			},
			{
				"name": "city",
				"type": "UTF8"
			},
			{
				"name": "state",
				"type": "UTF8"
			},
			{
				"name": "customer_segment",
				"type": "UTF8"
			},
			{
				"name": "customer_status",
				"type": "UTF8"
			},
			{
				"name": "created_at",
				"type": "INT96"
			},
			{
				"name": "updated_at",
				"type": "INT96"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}