{
	"name": "PL_Banking_Customers_Incremental",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Old_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    CONVERT(VARCHAR(23), last_watermark, 126) AS last_watermark\nFROM control.watermark_control\nWHERE source_schema = 'banking'\n  AND source_table = 'customers';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Control",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Lookup_New_Watermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup_Old_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    CONVERT(VARCHAR(23), SYSUTCDATETIME(), 126)\n        AS new_watermark;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Control",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Copy_Incremental_Customers",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_New_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n  'SELECT * FROM banking.customers WHERE updated_at > ''',\n  activity('Lookup_Old_Watermark').output.firstRow.last_watermark,\n  ''' AND updated_at <= ''',\n  activity('Lookup_New_Watermark').output.firstRow.new_watermark,\n  ''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_SQL_Customers",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Dynamic_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"p_container": "landing",
							"p_folder": {
								"value": "@concat(\n  'banking/customers/incremental/run_id=',\n  pipeline().RunId\n)",
								"type": "Expression"
							},
							"p_file": "customers.parquet"
						}
					}
				]
			},
			{
				"name": "Update_Watermark",
				"type": "SqlServerStoredProcedure",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Copy_Incremental_Customers",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_update_watermark]",
					"storedProcedureParameters": {
						"new_watermark": {
							"value": {
								"value": "@activity('Lookup_New_Watermark').output.firstRow.new_watermark",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"source_schema": {
							"value": "banking",
							"type": "String"
						},
						"source_table": {
							"value": "customers",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Banking",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set_New_Watermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_New_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_new_watermark",
					"value": {
						"value": "@activity('Lookup_New_Watermark').output.firstRow.new_watermark",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Return_New_Watermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_New_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "new_watermark",
							"value": {
								"type": "String"
							}
						}
					],
					"setSystemVariable": true
				}
			}
		],
		"variables": {
			"v_new_watermark": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-17T07:19:53Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}