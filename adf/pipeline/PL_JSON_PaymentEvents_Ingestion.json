								"sink": {
									"name": "channel"
								}
							},
							{
								"source": {
									"path": "$['event_time']"
								},
								"sink": {
									"name": "event_time"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_JSON_PaymentEvents_Source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Parquet_PaymentEvents_Landing",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
