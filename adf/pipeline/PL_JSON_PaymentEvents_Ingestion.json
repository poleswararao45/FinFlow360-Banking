								"sink": {
									"name": "event_id"
								}
							},
							{
								"source": {
									"path": "$['transaction_id']"
								},
								"sink": {
									"name": "transaction_id"
								}
							},
							{
								"source": {
									"path": "$['event_type']"
								},
								"sink": {
									"name": "event_type"
								}
							},
							{
								"source": {
									"path": "$['channel']"
